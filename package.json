{
  "name": "notion-sdk-types",
  "version": "2.3.0",
  "description": "Types exported from official Notion SDK, simplified with intuitive names and namespaces.",
  "engines": {
    "node": ">=12"
  },
  "homepage": "https://developers.notion.com/docs/getting-started",
  "bugs": {
    "url": "https://github.com/ntcho/notion-sdk-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ntcho/notion-sdk-types/"
  },
  "keywords": [
    "notion",
    "notionapi",
    "rest",
    "notion-api",
    "notion-sdk-types",
    "types"
  ],
  "main": "./build/src",
  "types": "./build/src/index.d.ts",
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run checkLoggedIn",
    "build": "node ./scripts/collect-types.js && prettier --write --ignore-path '' ./build/src/index.d.ts",
    "prebuild": "npm run clean",
    "clean": "rm -rf ./build",
    "checkLoggedIn": "./scripts/verifyLoggedIn.sh"
  },
  "author": "",
  "license": "MIT",
  "files": [
    "build/src/**"
  ],
  "devDependencies": {
    "eslint": "^7.24.0",
    "glob": "^11.0.2",
    "prettier": "^2.8.8",
    "typescript": "^4.8.4"
  }
}
